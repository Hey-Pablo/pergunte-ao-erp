# Banco de dados PostgreSQL
POSTGRES_USER=pergunte_user
POSTGRES_PASSWORD=senha_segura_aqui
POSTGRES_DB=pergunte_erp

# DATABASE_URL para o servidor (usa o usuário de leitura)
DATABASE_URL=postgresql://reader_user:reader_password_change_me@localhost:5432/pergunte_erp

# Credenciais do usuário de leitura (para o docker-compose)
READER_PASSWORD=reader_password_change_me

# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# Porta do servidor
PORT=3001

# AWS Bedrock (para geração de SQL com Claude)
AWS_ACCESS_KEY_ID=sua_access_key_aqui
AWS_SECRET_ACCESS_KEY=sua_secret_key_aqui
AWS_REGION=us-east-1

# Ambiente
NODE_ENV=development