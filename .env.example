# Configuracoes do banco de dados PostgreSQL
POSTGRES_USER=pergunte_user
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB=pergunte_erp

# Conexao para a aplicacao
DATABASE_URL=postgresql://pergunte_user:sua_senha_aqui@localhost:5432/pergunte_erp?schema=public

# Usuario de leitura (seguro)
READER_USER=reader_user
READER_PASSWORD=sua_senha_reader_aqui

# Configuracoes da API Claude (opcional para uso real)
# CLAUDE_API_KEY=sua_api_key_aqui
# AWS_ACCESS_KEY_ID=seu_access_key
# AWS_SECRET_ACCESS_KEY=seu_secret_key
# AWS_REGION=us-east-1

# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# Configuracao de timeout
QUERY_TIMEOUT_MS=30000
MAX_RESULTS=10000